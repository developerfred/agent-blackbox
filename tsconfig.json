{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/**/*.js",
    "bin/**/*.js",
    "eval/**/*.js",
    "bench/**/*.js",
    "src/**/*.ts",
    "bin/**/*.ts",
    "eval/**/*.ts",
    "bench/**/*.ts"
  ]
}
