{
  "name": "agent-blackbox",
  "version": "0.3.0",
  "description": "A tamper-evident flight recorder and lethal-trifecta firewall for AI coding agents (Claude Code first).",
  "license": "Apache-2.0",
  "author": "Frederick Silva (codingsh)",
  "bin": {
    "blackbox": "dist/bin/blackbox.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "bench": "node dist/bench/run.js",
    "eval": "node dist/bin/blackbox.js eval",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.strict.json",
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "coverage": "node --test --experimental-test-coverage test/*.test.js"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "security",
    "audit",
    "prompt-injection",
    "opentelemetry",
    "tamper-evident"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerfred/agent-blackbox.git"
  },
  "homepage": "https://github.com/developerfred/agent-blackbox#readme",
  "bugs": {
    "url": "https://github.com/developerfred/agent-blackbox/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
